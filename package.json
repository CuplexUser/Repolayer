{
  "name": "repolayer",
  "version": "1.0.1",
  "description": "A thin repository abstraction: write your data access once, swap SQLite for Postgres later.",
  "keywords": [
    "repository",
    "sqlite",
    "postgres",
    "mysql",
    "mariadb",
    "database",
    "abstraction",
    "adapter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CuplexUser/Repolayer.git"
  },
  "homepage": "https://github.com/CuplexUser/Repolayer#readme",
  "bugs": {
    "url": "https://github.com/CuplexUser/Repolayer/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/sqlite/index.d.ts",
        "default": "./dist/sqlite/index.js"
      },
      "require": {
        "types": "./dist/sqlite/index.d.cts",
        "default": "./dist/sqlite/index.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres/index.d.ts",
        "default": "./dist/postgres/index.js"
      },
      "require": {
        "types": "./dist/postgres/index.d.cts",
        "default": "./dist/postgres/index.cjs"
      }
    },
    "./mysql": {
      "import": {
        "types": "./dist/mysql/index.d.ts",
        "default": "./dist/mysql/index.js"
      },
      "require": {
        "types": "./dist/mysql/index.d.cts",
        "default": "./dist/mysql/index.cjs"
      }
    },
    "./memory": {
      "import": {
        "types": "./dist/memory/index.d.ts",
        "default": "./dist/memory/index.js"
      },
      "require": {
        "types": "./dist/memory/index.d.cts",
        "default": "./dist/memory/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "test:pg": "node scripts/test-db.mjs postgres",
    "test:mysql": "node scripts/test-db.mjs mysql",
    "test:mariadb": "node scripts/test-db.mjs mariadb",
    "test:all": "node scripts/test-db.mjs postgres mysql mariadb",
    "example:swap": "npm run build && node --experimental-strip-types examples/swap/index.ts",
    "example:stream-export": "npm run build && node --experimental-strip-types examples/stream-export/index.ts",
    "example:paging-api": "npm run build && node --experimental-strip-types examples/paging-api/index.ts",
    "example:memory-testing": "npm run build && node --experimental-strip-types examples/memory-testing/index.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "mysql2": "^3.9.0",
    "pg": "^8.11.0",
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "mysql2": "^3.23.4",
    "pg": "^8.13.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
